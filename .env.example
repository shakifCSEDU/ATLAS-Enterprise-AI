#Aws configuration
AWS_ACCESS_KEY_ID = "your_aws_access_key"
AWS_SECRET_ACCESS_KEY = "your_aws_secret_key"
AWS_REGION = "ap-southeast-1"
S3_BUCKET = atlas-enterprise-ai-420 

# Bedrock model configuration
BEDROCK_EMBED_MODEL = cohere.embed-multilingual-v3
BEDROCK_CHAT_MODEL = apac.amazon.nova-lite-v1:0
EMBED_DIM = 1024

#Pinecone Vector database configuration
PINECONE_API_KEY = your_pinecode_api_key
PINECONE_INDEX_HOST = "atlas-enterprise-ai-index"
PINECONE_CLOUD = "aws"
PINECONE_REGION=ap-southeast-1
PINECONE_READY_TIMEOUT = 180

#Render PostGresql DB
DATABASE_URL= your_render_postgresql_host

#RIUS Observability configuration
RIUS_API_KEY = "rius_api_key"
RIUS_SERVICE_NAME=atlas-ai-enterprise
RIUS_DISABLED=false
RIUS_CAPTURE_CONTENT=false